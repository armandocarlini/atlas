{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armandocarlini/atlas.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k -s first \"npm:dev\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/start-electron.mjs",
    "start": "node scripts/start-electron.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:agent": "node --test scripts/agent-*.test.mjs",
    "smoke:agent": "node scripts/smoke-agent.mjs",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1"
  }
}
